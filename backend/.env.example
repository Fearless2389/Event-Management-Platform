MONGO_URI=mongodb://localhost:27017/eventmgmt
PORT=3001
FRONTEND_URL=http://localhost:5173

# JWT signing secret. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_64_random_hex_chars

# Razorpay test keys (https://dashboard.razorpay.com -> Settings -> API Keys, "Generate Test Key")
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me

# Resend (https://resend.com -> API Keys). Free tier: 3000 emails/month, no card.
# The sandbox `onboarding@resend.dev` only delivers to the email you signed up with.
# To send to anyone, verify your domain in the Resend dashboard and set EMAIL_FROM accordingly.
RESEND_API_KEY=
EMAIL_FROM=EventHub <onboarding@resend.dev>
